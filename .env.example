# URL do servidor LLM local (llama.cpp), incluindo o /v1
LLAMA_BASE_URL=http://SEU-SERVIDOR-LLM:9090/v1

# Configuração do modelo
# MODEL_ID = id usado pelo OpenCode (provider/id); MODEL_NAME = nome exibido
# O nome do modelo pode ser qualquer um: servidores OpenAI-compatible ignoram o campo.
MODEL_PROVIDER=local
MODEL_ID=qwen
MODEL_NAME=Qwen

# Limites do modelo. Devem ser <= n_ctx do llama.cpp.
# Deixe folga para system prompt + tools; se bater no teto o servidor rejeita.
CONTEXT_LIMIT=122880
# OUTPUT consome o mesmo contexto da janela.
OUTPUT_LIMIT=8192

# Compaction (gerenciamento de contexto)
# keep.tokens = tokens recentes preservados depois de resumir
# buffer      = folga reservada antes do limite para disparar a compactação
COMPACTION_AUTO=true
COMPACTION_KEEP_TOKENS=15000
COMPACTION_BUFFER=20000

# Idioma dos resumos do auto-capture do opencode-mem (pt por padrão)
AUTO_CAPTURE_LANGUAGE=pt

# Web UI do opencode-mem (http://localhost:4747)
# Deixe em branco para não expor/desabilitar o acesso, ou gere um segredo:
#   openssl rand -hex 24
# user fixo: admin (a senha abaixo). O token protege /api/*.
OPENCODE_MEM_WEB_PASSWORD=
OPENCODE_MEM_WEB_TOKEN=

# chown recursivo do /workspace:
#   auto  = pula em Docker Desktop (virtiofs/9p) e faz em Linux nativo (padrao)
#   true  = sempre faz o chown recursivo
#   false = nunca faz (pula em Linux nativo ou monorepos gigantes)
CHOWN_WORKSPACE=auto

# ---------------------------------------------------------------------------
# uid/gid com que o opencode roda dentro do container.
#
# Em Linux nativo isso importa: sem isso os arquivos criados no workspace
# ficam root-owned e você precisa de sudo para editar.
# Coloque aqui o resultado de `id -u` e `id -g` da sua máquina Linux.
#
# Em macOS e Windows (Docker Desktop) não tem efeito prático: o ownership é
# virtualizado e os arquivos sempre aparecem como seus.
# ---------------------------------------------------------------------------
PUID=1000
PGID=1000
